{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sidelingo",
  "version": "0.1.0",
  "identifier": "io.github.mcdp-adk.sidelingo",
  "build": {
    "beforeDevCommand": "pnpm notices && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm notices && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": { "resources/THIRD-PARTY-NOTICES.html": "THIRD-PARTY-NOTICES.html" },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": false
      }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERENjM0OUU0QkQ5MUMyMUIKUldRYndwRzk1RWxqM1NPaUllbGp0Ly95UkI2YjVaYnFIY3I0UWNGV08vL3BESjF3aGNnRmN0c24K",
      "endpoints": ["https://github.com/mcdp-adk/sidelingo/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
