{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "prototype-links",
  "description": "PROTOTYPE (branch prototype/winui-look): let Pin window links open in the default browser",
  "windows": ["pin"],
  "permissions": [
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    }
  ]
}
